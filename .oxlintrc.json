{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    // Nominal instances and the types of Astro and Starlight are not deeply read-only; the rule
    // would ask for wrappers that add nothing.
    "typescript/prefer-readonly-parameter-types": "off",
    // Nominal instances go into templates as they are: their text form is their value.
    "typescript/restrict-template-expressions": "off",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/explicit-member-accessibility": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-default-export": "error",
    "import/no-cycle": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "max-classes-per-file": ["error", 1],
    "max-depth": ["error", 4],
    "no-console": "error",
    "no-restricted-globals": ["error", "Boolean"]
  },
  "overrides": [
    {
      "files": ["astro.config.ts", "src/content.config.ts"],
      // Astro reads its configuration from a default export, and the site's configuration names
      // every plugin it uses.
      "rules": { "import/no-default-export": "off", "import/max-dependencies": "off" }
    },
    {
      "files": ["**/__tests__/**"],
      // A describe block holds every case of one unit; its length follows the cases.
      "rules": { "max-lines-per-function": "off" }
    },
    {
      "files": ["src/site/types.ts", "src/site/player-page.ts"],
      // The domain's nominal types, one line each, read best side by side.
      "rules": { "max-classes-per-file": "off" }
    }
  ],
  "ignorePatterns": ["dist/**", ".astro/**", ".cache/**", "src/generated/**"]
}
