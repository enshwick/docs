{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noPropertyAccessFromIndexSignature": true,
    "useUnknownInCatchVariables": true,
    "types": ["bun"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", ".cache"],
  "contentMappers": [
    {
      "package": "@astrojs/ts-content-mapper",
      "extensions": [".astro"]
    }
  ]
}
