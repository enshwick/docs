{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "sortImports": {
    "groups": ["builtin", "external", ["internal", "parent", "sibling", "index"]],
    "internalPattern": ["@enshwick/"]
  },
  "ignorePatterns": [
    "**/*.md",
    "**/*.mdx",
    "dist/**",
    ".astro/**",
    ".cache/**",
    "src/generated/**",
    "bun.lock"
  ]
}
