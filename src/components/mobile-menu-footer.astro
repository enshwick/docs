---
import { Languages } from '../site/languages.ts';
import { Links } from '../site/links.ts';
import { Texts } from '../site/texts.ts';
import { Translations } from '../site/translations.ts';
import LanguageSelect from './language-select.astro';
import ServiceIcon from './service-icon.astro';

// The narrow menu's foot carries what the bar has no room for there.
const language = Languages.site.of(Astro.locals.starlightRoute.lang);
const t = (key: string): string => Texts.site.get(key, language);
---

<div class="ew-menu-foot">
  <nav class="ew-menu-foot__links" aria-label={t('foot.links')}>
    <a href={Translations.href('/dev/api-coverage/', language)}>{t('nav.coverage')}</a>
    <a href={Translations.href('/aims/', language)}>{t('nav.aims')}</a>
    <a href={Links.site.download.toString()}>{t('nav.download')}</a>
    <a class="ew-foot__service" href={Links.site.github.toString()}><ServiceIcon service="github" />GitHub</a>
    <a class="ew-foot__service" href={Links.site.nexus.toString()}><ServiceIcon service="nexus" />Nexus Mods</a>
  </nav>
  <LanguageSelect language={language} />
</div>
