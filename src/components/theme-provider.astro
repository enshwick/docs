---
import KbdThemeProvider from 'starlight-kbd/overrides/ThemeProvider.astro';

// The site has one look, the night; the keyboard plugin's provider rides along.
---

<KbdThemeProvider />
<script is:inline>
  document.documentElement.dataset.theme = 'dark';
  window.StarlightThemeProvider = { updatePickers() {} };
</script>
