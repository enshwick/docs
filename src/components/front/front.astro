---
import compat from '../../generated/compatibility.json';
import modLines from '../../data/mods.json';
import smallestModSource from '../../generated/smallest-mod.rs?raw';
import { FrontData } from '../../site/front.ts';
import { languages } from '../../site/languages.ts';
import { links } from '../../site/links.ts';
import { Snippet, SnippetLanguage } from '../../site/snippet.ts';
import { texts } from '../../site/texts.ts';
import NightSky from '../night-sky.astro';
import ServiceIcon from '../service-icon.astro';

interface Props {
  /** The page's language code; the root language has none in its path. */
  lang: string;
}

const { lang } = Astro.props;
const code = languages.all.find((language) => language.code.toString() === lang)?.code ?? languages.root;
const t = (key: string): string => texts.get(key, code);
const data = FrontData.from(compat, modLines, lang);
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const prefix = code.equals(languages.root) ? base : `${base}/${lang}`;
const faq = ['safe', 'server', 'linux', 'saves', 'update', 'free'];
const steps = [1, 2, 3, 4];
const client = data.gameBuilds.find((build) => build.side === 'client');
const sections = [
  { id: 'top', key: 'front.nav.top' },
  { id: 'install', key: 'front.install.title' },
  { id: 'mods', key: 'front.mods.title' },
  { id: 'questions', key: 'front.faq.title' },
];

// The smallest whole mod, as the book compiles it; `tools/fetch.ts` takes it from the book.
const smallestMod = new Snippet(smallestModSource.trimEnd(), SnippetLanguage.Rust).html();
---

<div class="ew-front not-content">
  <section class="ew-hero" id="top" aria-labelledby="ew-title">
    <NightSky variant="hero" />
    <div class="ew-hero__body">
      <div class="ew-hero__copy">
        <h1 id="ew-title">{t('front.title')}</h1>
        <p class="ew-hero__lead">{t('front.lead')}</p>
        <p class="ew-hero__luau">{t('front.luau')}</p>
        <a class="ew-button ew-button--primary" href={links.download.toString()}>{t('front.download')}</a>
        {
          data.version !== undefined && (
            <div class="ew-release">
              <dl class="ew-versions">
                <div>
                  <dt>{t('front.tech.api')}</dt>
                  <dd>{data.version}</dd>
                </div>
                {client !== undefined && (
                  <div>
                    <dt>{t('front.tech.client')}</dt>
                    <dd>{client.name}</dd>
                  </div>
                )}
              </dl>
              <a href={`${prefix}/reference/compatibility/`}>{t('front.tech.link')}</a>
            </div>
          )
        }
        <div class="ew-actions">
          <a class="ew-button ew-button--quiet" href={`${prefix}/dev/getting-started/`}>{t('front.write')}</a>
          <a class="ew-button ew-button--quiet" href={`${prefix}/start/first-modded-game/`}>{t('topic.players')}</a>
        </div>
        <p class="ew-hero__mods">
          <a href="#mods">{t('front.mods.link')}</a>
        </p>
      </div>
      <figure class="ew-clearing" aria-labelledby="ew-clearing-caption">
        <figcaption id="ew-clearing-caption">
          {t('front.excerpt.caption')}
          <a href={`${prefix}/dev/getting-started/#a-first-mod`}>{t('front.excerpt.link')}</a>
        </figcaption>
        <pre><code set:html={smallestMod} /></pre>
      </figure>
    </div>
  </section>

  <section class="ew-section ew-section--band" id="install" aria-labelledby="ew-install">
    <div class="ew-wrap">
      <h2 id="ew-install">{t('front.install.title')}</h2>
      <div class="ew-install">
        <div class="ew-install__way">
          <h3>{t('front.install.auto')}</h3>
          <a class="ew-nexus" href={links.nexus.toString()}>
            <ServiceIcon service="nexus" />
            <span class="ew-nexus__text">
              <span class="ew-nexus__name">{t('front.ways.nexus')}</span>
              <span class="ew-nexus__note">{t('front.install.nexus.note')}</span>
            </span>
          </a>
        </div>
        <div class="ew-install__way">
          <h3>{t('front.install.manual')}</h3>
          <ol class="ew-steps">
            {
              steps.map((step) =>
                step === 1 ? (
                  <li>
                    <a href={links.download.toString()}>{t(`front.install.step.${step}`)}</a>
                  </li>
                ) : (
                  <li>{t(`front.install.step.${step}`)}</li>
                ),
              )
            }
          </ol>
          <p class="ew-install__note">
            <a href={`${prefix}/start/first-modded-game/`}>{t('front.ways.linux')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="ew-section" id="mods" aria-labelledby="ew-mods">
    <div class="ew-wrap">
      <h2 id="ew-mods">{t('front.mods.title')}</h2>
      <ul class="ew-mods">
        {
          data.mods.map((mod) => (
            <li>
              {mod.page ? (
                <a class="ew-mods__row" href={`${prefix}/mods/${mod.slug}/`}>
                  <span class="ew-mods__name">{mod.name}</span>
                  <span class="ew-mods__line">{mod.line}</span>
                </a>
              ) : (
                <span class="ew-mods__row">
                  <span class="ew-mods__name">{mod.name}</span>
                  <span class="ew-mods__line">{mod.line}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ew-section ew-section--band" id="questions" aria-labelledby="ew-faq">
    <div class="ew-wrap ew-faq-wrap">
      <h2 id="ew-faq">{t('front.faq.title')}</h2>
      <div class="ew-faq">
        {
          faq.map((id) => (
            <details id={`faq-${id}`}>
              <summary>{t(`front.faq.${id}.q`)}</summary>
              <p>{t(`front.faq.${id}.a`)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <nav class="ew-onpage" aria-label={t('front.nav.label')}>
    <ul>
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : undefined}>
              {t(section.key)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  import { NightFog } from '../../scripts/night-fog.ts';
  import { SectionMarker } from '../../scripts/section-marker.ts';

  document.addEventListener('astro:page-load', () => {
    NightFog.start();
    SectionMarker.start();
  });
</script>
