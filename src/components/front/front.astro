---
import compat from '../../generated/compatibility.json';
import modLines from '../../data/mods.json';
import smallestModSource from '../../generated/smallest-mod.rs?raw';
import { FrontData } from '../../site/front.ts';
import { Languages } from '../../site/languages.ts';
import { Links } from '../../site/links.ts';
import { Snippet, SnippetLanguage } from '../../site/snippet.ts';
import { Texts } from '../../site/texts.ts';
import NightSky from '../night-sky.astro';
import ServiceIcon from '../service-icon.astro';

interface Props {
  /** The page's language code; the root language has none in its path. */
  lang: string;
}

const { lang } = Astro.props;
const code = Languages.site.all.find((language) => language.code.toString() === lang)?.code ?? Languages.site.root;
const t = (key: string): string => Texts.site.get(key, code);
const data = FrontData.from(compat, modLines, lang);
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const prefix = code.equals(Languages.site.root) ? base : `${base}/${lang}`;
const steps = [1, 2, 3, 4];
const sections = [
  { id: 'top', key: 'front.nav.top' },
  { id: 'players', key: 'front.nav.players' },
  { id: 'makers', key: 'front.nav.makers' },
  { id: 'install', key: 'front.install.title' },
  { id: 'mods', key: 'front.mods.title' },
  { id: 'questions', key: 'front.faq.title' },
  { id: 'contribute', key: 'front.nav.contribute' },
];
// Each row: its key under `front.<group>.`, and the page its answer links to, where it has one.
const players = [
  { id: 'patch' },
  { id: 'clash' },
  { id: 'fault' },
  { id: 'join', href: `${prefix}/guides/play-on-a-server/` },
  { id: 'settings', href: `${prefix}/reference/where-files-live/` },
];
const makers = [
  { id: 'api', href: `${prefix}/api-coverage/` },
  { id: 'patches' },
  { id: 'together' },
  { id: 'languages', href: `${prefix}/dev/mods-in-c/` },
  { id: 'speed', href: `${prefix}/dev/concepts/performance/` },
  { id: 'tool', href: `${prefix}/dev/getting-started/` },
  { id: 'levels' },
  { id: 'texts' },
];
const contribute = [
  { id: 'api', href: Links.site.ideas.toString() },
  { id: 'help', href: Links.site.contributing.toString() },
];

// The smallest whole mod, as the book compiles it; `tools/fetch.ts` takes it from the book.
const smallestMod = new Snippet(smallestModSource.trimEnd(), SnippetLanguage.Rust).html();
---

<div class="ew-front not-content">
  <section class="ew-hero" id="top" aria-labelledby="ew-title">
    <NightSky variant="hero" />
    <div class="ew-hero__body">
      <div class="ew-hero__copy">
        <h1 id="ew-title">{t('front.title')}</h1>
        <p class="ew-hero__lead">{t('front.lead')}</p>
        <div class="ew-actions" data-nosnippet>
          <a class="ew-button ew-button--primary" href="#install">{t('front.install')}</a>
          <a class="ew-button ew-button--quiet" href={`${prefix}/dev/getting-started/`}>{t('front.write')}</a>
        </div>
        {
          data.version !== undefined && (
            <div class="ew-release" data-nosnippet>
              <dl class="ew-versions">
                <div>
                  <dt>{t('front.tech.api')}</dt>
                  <dd>{data.version}</dd>
                </div>
                <div>
                  <dt>{t('front.tech.game')}</dt>
                  <dd>{t('front.tech.latest')}</dd>
                </div>
              </dl>
              <a href={`${prefix}/reference/compatibility/`}>{t('front.tech.link')}</a>
            </div>
          )
        }
        <p class="ew-hero__mods">
          <a href="#mods">{t('front.mods.link')}</a>
        </p>
      </div>
      <figure class="ew-clearing" aria-labelledby="ew-clearing-caption">
        <figcaption id="ew-clearing-caption">
          {t('front.excerpt.caption')}
          <a href={`${prefix}/dev/getting-started/#a-rust-mod`}>{t('front.excerpt.link')}</a>
        </figcaption>
        <pre><code set:html={smallestMod} /></pre>
      </figure>
    </div>
  </section>

  <section class="ew-section" id="players" aria-labelledby="ew-players">
    <div class="ew-wrap">
      <h2 id="ew-players">{t('front.players.title')}</h2>
      <ul class="ew-mods ew-points">
        {
          players.map((row) => (
            <li class="ew-mods__row">
              <h3 class="ew-mods__name">{t(`front.players.${row.id}.q`)}</h3>
              <p class="ew-mods__line">
                {t(`front.players.${row.id}.a`)}
                {row.href !== undefined && (
                  <a class="ew-points__link" href={row.href}>{t(`front.players.${row.id}.link`)}</a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="ew-note">{t('front.players.caveat')}</p>
    </div>
  </section>

  <section class="ew-section ew-section--band" id="makers" aria-labelledby="ew-makers">
    <div class="ew-wrap">
      <h2 id="ew-makers">{t('front.makers.title')}</h2>
      <ul class="ew-mods ew-points">
        {
          makers.map((row) => (
            <li class="ew-mods__row">
              <h3 class="ew-mods__name">{t(`front.makers.${row.id}.q`)}</h3>
              <p class="ew-mods__line">
                {t(`front.makers.${row.id}.a`)}
                {row.href !== undefined && (
                  <a class="ew-points__link" href={row.href}>{t(`front.makers.${row.id}.link`)}</a>
                )}
              </p>
            </li>
          ))
        }
      </ul>
      <p class="ew-note">
        {t('front.makers.abi')}
        <a class="ew-points__link" href={`${prefix}/aims/`}>{t('front.contribute.aims')}</a>
      </p>
    </div>
  </section>

  <section class="ew-section" id="install" aria-labelledby="ew-install">
    <div class="ew-wrap">
      <h2 id="ew-install">{t('front.install.title')}</h2>
      <div class="ew-install">
        <div class="ew-install__way">
          <h3>{t('front.install.auto')}</h3>
          <a class="ew-nexus" href={Links.site.nexus.toString()}>
            <ServiceIcon service="nexus" />
            <span class="ew-nexus__text">
              <span class="ew-nexus__name">{t('front.ways.nexus')}</span>
              <span class="ew-nexus__note">{t('front.install.nexus.note')}</span>
            </span>
          </a>
        </div>
        <div class="ew-install__way">
          <h3>{t('front.install.manual')}</h3>
          <ol class="ew-steps">
            {
              steps.map((step) =>
                step === 1 ? (
                  <li>
                    <a href={Links.site.download.toString()}>{t(`front.install.step.${step}`)}</a>
                  </li>
                ) : (
                  <li>{t(`front.install.step.${step}`)}</li>
                ),
              )
            }
          </ol>
          <p class="ew-install__note">
            <a href={`${prefix}/start/first-modded-game/`}>{t('front.ways.linux')}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="ew-section ew-section--band" id="mods" aria-labelledby="ew-mods">
    <div class="ew-wrap">
      <h2 id="ew-mods">{t('front.mods.title')}</h2>
      <ul class="ew-mods">
        {
          data.mods.map((mod) => (
            <li>
              {mod.page ? (
                <a class="ew-mods__row" href={`${prefix}/mods/${mod.slug}/`}>
                  <span class="ew-mods__name">{mod.name}</span>
                  <span class="ew-mods__line">{mod.line}</span>
                </a>
              ) : (
                <span class="ew-mods__row">
                  <span class="ew-mods__name">{mod.name}</span>
                  <span class="ew-mods__line">{mod.line}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ew-section" id="questions" aria-labelledby="ew-faq">
    <div class="ew-wrap ew-faq-wrap">
      <h2 id="ew-faq">{t('front.faq.title')}</h2>
      <div class="ew-faq">
        {
          FrontData.questions.map((id) => (
            <details id={`faq-${id}`}>
              <summary>{t(`front.faq.${id}.q`)}</summary>
              <p>{t(`front.faq.${id}.a`)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="ew-section ew-section--band" id="contribute" aria-labelledby="ew-contribute">
    <div class="ew-wrap">
      <h2 id="ew-contribute">{t('front.contribute.title')}</h2>
      <ul class="ew-mods ew-points">
        {
          contribute.map((row) => (
            <li class="ew-mods__row">
              <h3 class="ew-mods__name">{t(`front.contribute.${row.id}.q`)}</h3>
              <p class="ew-mods__line">
                {t(`front.contribute.${row.id}.a`)}
                <a class="ew-points__link" href={row.href}>{t(`front.contribute.${row.id}.link`)}</a>
              </p>
            </li>
          ))
        }
      </ul>
      <p class="ew-note">
        <a href={`${prefix}/aims/`}>{t('front.contribute.aims')}</a>
      </p>
    </div>
  </section>

  <nav class="ew-onpage" aria-label={t('front.nav.label')}>
    <ul>
      {
        sections.map((section, index) => (
          <li>
            <a href={`#${section.id}`} aria-current={index === 0 ? 'true' : undefined}>
              <span data-nosnippet>{t(section.key)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  import { NightFog } from '../../scripts/night-fog.ts';
  import { SectionMarker } from '../../scripts/section-marker.ts';

  document.addEventListener('astro:page-load', () => {
    NightFog.start();
    SectionMarker.start();
  });
</script>
