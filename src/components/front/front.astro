---
import compat from '../../generated/compatibility.json';
import modLines from '../../data/mods.json';
import { frontData } from '../../site/front.ts';
import { languages } from '../../site/languages.ts';
import { links } from '../../site/links.ts';
import { Snippet, SnippetLanguage } from '../../site/snippet.ts';
import { texts } from '../../site/texts.ts';
import NightSky from '../night-sky.astro';

interface Props {
  /** The page's language code; the root language has none in its path. */
  lang: string;
}

const { lang } = Astro.props;
const code = languages.all.find((language) => language.code.toString() === lang)?.code ?? languages.root;
const t = (key: string): string => texts.get(key, code);
const data = frontData(compat, modLines, lang);
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const prefix = code.equals(languages.root) ? base : `${base}/${lang}`;
const faq = ['safe', 'server', 'linux', 'saves', 'update', 'free'];
const chain = [
  { title: 'powrprof.dll', mono: true, body: t('front.how.1') },
  { title: t('front.how.2.title'), mono: false, body: t('front.how.2') },
  { title: t('front.how.3.title'), mono: false, body: t('front.how.3') },
  { title: t('front.how.4.title'), mono: false, body: t('front.how.4') },
];
const client = data.gameBuilds.find((build) => build.side === 'client');
const server = data.gameBuilds.find((build) => build.side === 'server');
const excerptMod = 'build-camera';
const excerptSource = `https://github.com/enshwick/mod-${excerptMod}/blob/main/src/lib.rs`;

// A real excerpt of the Build Camera mod's start, trimmed to the lines that show its rule.
const excerpt = new Snippet(
  `fn init(load: &mut Load<'_>) -> Result<Self, Off> {
    load.on_skill(Skill::AirborneArchitect, |check| {
        lifts(check.gate, enabled().load(Ordering::Relaxed))
    })?;
    Ok(Self)
}`,
  SnippetLanguage.Rust,
).html();
const newMod = new Snippet('cargo enshwick new you.my-mod --side server', SnippetLanguage.Shell).html();
const luau = new Snippet(
  `enshwick.on("PlayerJoined", function(player)
  local joined = enshwick.world.player(player.entity)
  if joined then
    enshwick.world.tell(joined, \`Welcome, {joined.name}\`)
  end
end)`,
  SnippetLanguage.Luau,
).html();
const needs = (side: string): string => t(`front.needs.${side}`);
---

<div class="ew-front not-content">
  <section class="ew-hero" aria-labelledby="ew-title">
    <NightSky variant="hero" />
    <div class="ew-hero__body">
      <div class="ew-hero__copy">
        <h1 id="ew-title">{t('front.title')}</h1>
        <p class="ew-hero__lead">{t('front.lead')}</p>
        <div class="ew-actions">
          <a class="ew-button ew-button--flame" href={`${prefix}/dev/getting-started/`}>{t('front.write')}</a>
          <a class="ew-button ew-button--stone" href={`${prefix}/start/first-modded-game/`}>{t('topic.players')}</a>
        </div>
        <p class="ew-hero__count">
          <span>{t('front.count').replace('{count}', data.mods.length.toString())}</span>
          <a href="#mods">{t('front.count.link')}</a>
        </p>
      </div>
      <figure class="ew-clearing" aria-label={t('front.excerpt.label')}>
        <pre><code set:html={excerpt} /></pre>
        <figcaption>
          {t('front.excerpt.caption')} <a href={excerptSource}>{t('front.excerpt.link')}</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="ew-section" aria-labelledby="ew-ways">
    <div class="ew-wrap">
      <h2 id="ew-ways">{t('front.ways.title')}</h2>
      <div class="ew-ways">
        <article class="ew-way">
          <h3>{t('topic.players')}</h3>
          <ol class="ew-steps">
            <li><a href={links.download.toString()}>{t('front.install.manual.1')}</a></li>
            <li>{t('front.install.manual.2')}</li>
            <li>{t('front.install.manual.3')}</li>
          </ol>
          <p>{t('front.ways.screen')}</p>
          <p>
            {t('front.ways.managers')}{' '}
            <a href={links.nexus.toString()}>{t('front.install.vortex.link')}</a>,{' '}
            <a href={links.vortex.toString()}>{t('foot.vortex')}</a>.
          </p>
          <p><a href={`${prefix}/start/first-modded-game/`}>{t('front.ways.linux')}</a></p>
        </article>
        <article class="ew-way">
          <h3>{t('topic.developers')}</h3>
          <p>{t('front.ways.new')}</p>
          <pre class="ew-code"><code set:html={newMod} /></pre>
          <p>{t('front.ways.luau')}</p>
          <pre class="ew-code"><code set:html={luau} /></pre>
          <p><a href={`${prefix}/dev/`}>{t('front.ways.guide')}</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="ew-section" id="mods" aria-labelledby="ew-mods">
    <div class="ew-wrap">
      <h2 id="ew-mods">{t('front.mods.title')}</h2>
      <ul class="ew-mods">
        {
          data.mods.map((mod) => (
            <li class="ew-mod">
              <h3>
                {mod.page ? <a href={`${prefix}/mods/${mod.slug}/`}>{mod.name}</a> : mod.name}
              </h3>
              <p>{mod.line}</p>
              <p class="ew-mod__side">{needs(mod.needs)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="ew-section" aria-labelledby="ew-how">
    <div class="ew-wrap">
      <h2 id="ew-how">{t('front.how.title')}</h2>
      <ol class="ew-chain">
        {
          chain.map((link) => (
            <li class="ew-chain__link">
              <h3 class:list={{ 'ew-chain__mono': link.mono }}>{link.title}</h3>
              <p>{link.body}</p>
            </li>
          ))
        }
      </ol>
      <p class="ew-how__after">{t('front.how.after')}</p>
    </div>
  </section>

  {
    data.version !== undefined && (
      <section class="ew-strip" aria-labelledby="ew-tech">
        <div class="ew-wrap ew-strip__body">
          <h2 id="ew-tech">{t('front.tech.title')}</h2>
          <dl>
            <div>
              <dt>{t('front.tech.api')}</dt>
              <dd>{data.version}</dd>
            </div>
            {client !== undefined && (
              <div>
                <dt>{t('front.tech.client')}</dt>
                <dd>{client.name}</dd>
              </div>
            )}
            {server !== undefined && (
              <div>
                <dt>{t('front.tech.server')}</dt>
                <dd>{server.name}</dd>
              </div>
            )}
          </dl>
          <a href={`${prefix}/reference/compatibility/`}>{t('front.tech.link')}</a>
        </div>
      </section>
    )
  }

  <section class="ew-section" aria-labelledby="ew-faq">
    <div class="ew-wrap ew-faq-wrap">
      <h2 id="ew-faq">{t('front.faq.title')}</h2>
      <div class="ew-faq">
        {
          faq.map((id) => (
            <details id={`faq-${id}`}>
              <summary>{t(`front.faq.${id}.q`)}</summary>
              <p>{t(`front.faq.${id}.a`)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</div>

<script>
  import { NightFog } from '../../scripts/night-fog.ts';

  NightFog.start();
</script>
