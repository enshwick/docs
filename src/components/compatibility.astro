---
import raw from '../generated/compatibility.json';
import { CompatibilityData } from '../site/compatibility.ts';
import { BuildState, GameBuildRows } from '../site/game-build-rows.ts';
import { Languages } from '../site/languages.ts';
import { Texts } from '../site/texts.ts';

const data = CompatibilityData.parse(raw);

if (!data.ok) {
  throw new TypeError(`src/generated/compatibility.json: ${JSON.stringify(data.issues)}`);
}

const { platform, mods } = data.value;
const language = Languages.site.of(Astro.currentLocale);
const t = (key: string): string => Texts.site.get(key, language);
const prefix = language.equals(Languages.site.root) ? '' : `/${language}`;
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const feature = (name: string): string =>
  Texts.site.has(`compat.feature.${name}`, Languages.site.root) ? t(`compat.feature.${name}`) : name;
const state = (row: { state: BuildState; off: readonly string[] }): string =>
  row.state === BuildState.Partly
    ? `${t('compat.state.partly')} ${row.off.map(feature).join(', ')}`
    : t(`compat.state.${row.state}`);
---

<h2>{t('compat.platform')}</h2>
<div class="ew-table" tabindex="0"><table>
  <thead>
    <tr>
      <th>{t('compat.version')}</th>
      <th>{t('compat.api')}</th>
      <th>{t('compat.side')}</th>
      <th>{t('compat.steam')}</th>
      <th>{t('compat.game-version')}</th>
      <th>{t('compat.state')}</th>
    </tr>
  </thead>
  <tbody>
    {
      platform.flatMap((release) =>
        GameBuildRows.of(release.builds).map((row) => (
          <tr>
            <td>{release.name}</td>
            <td>{release.api ?? ''}</td>
            <td>{t(`compat.side.${row.side}`)}</td>
            <td>{row.steamBuild ?? ''}</td>
            <td>{row.gameVersion ?? ''}</td>
            <td>{state(row)}</td>
          </tr>
        )),
      )
    }
  </tbody>
</table></div>

<h2>{t('compat.mods')}</h2>
<div class="ew-table" tabindex="0"><table>
  <thead>
    <tr>
      <th>{t('compat.mod')}</th>
      <th>{t('compat.mod-version')}</th>
      <th>{t('compat.needs-api')}</th>
      <th>{t('mod.needs')}</th>
      <th>{t('compat.release')}</th>
    </tr>
  </thead>
  <tbody>
    {
      mods.map((mod) => (
        <tr>
          <td>{mod.page ? <a href={`${base}${prefix}/mods/${mod.slug}/`}>{mod.name}</a> : mod.name}</td>
          <td>{mod.version ?? ''}</td>
          <td>{mod.api ?? ''}</td>
          <td>{mod.needs === undefined ? '' : t(`mod.who.${mod.needs.toString()}`)}</td>
          <td>
            <a href={`https://github.com/${mod.repository}/releases/tag/${mod.tag}`}>{mod.tag}</a>
          </td>
        </tr>
      ))
    }
  </tbody>
</table></div>
