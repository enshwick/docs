---
import { Coverage } from '../site/coverage.ts';
import { Languages } from '../site/languages.ts';
import { Texts } from '../site/texts.ts';

const language = Languages.site.of(Astro.currentLocale);
const t = (key: string): string => Texts.site.get(key, language);
const totals = [
  { key: 'coverage.total.one', count: Coverage.total(Coverage.site.forOne) },
  { key: 'coverage.total.all', count: Coverage.total(Coverage.site.domains) },
].map(({ key, count }) => {
  const percent = Coverage.percent(count);

  return {
    label: t(key),
    count: `${count.covered} / ${count.of}`,
    rest: `${t('coverage.covered-count')}${percent === undefined ? '' : ` (${percent}%)`}`,
  };
});
---

<ul>
  {
    totals.map(({ label, count, rest }) => (
      <li>
        {label}: <strong>{count}</strong> {rest}
      </li>
    ))
  }
</ul>
<p>{t('coverage.total.grows')}</p>
