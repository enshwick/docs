---
import Default from '@astrojs/starlight/components/PageTitle.astro';

import raw from '../generated/stability.json';
import { Languages } from '../site/languages.ts';
import { PageId } from '../site/page-id.ts';
import { StabilityBadges } from '../site/stability-badges.ts';
import { Texts } from '../site/texts.ts';
import { LanguageCode } from '../site/types.ts';
import ModCard from './mod-card.astro';

const stability = StabilityBadges.parse(raw);

if (!stability.ok) {
  throw new TypeError(`src/generated/stability.json: ${JSON.stringify(stability.issues)}`);
}

// The front page draws its own heading, so it gets no second h1. A mod's page opens with its
// card, an error page with its code, and an API page with the stability of its module, linked to
// the chapter that says what stability means.
const route = Astro.locals.starlightRoute;
const front = new PageId(route.id).isFront;
const parsed = LanguageCode.parse(route.lang);
const language = parsed.ok ? parsed.value : Languages.site.root;
const t = (key: string): string => Texts.site.get(key, language);
const { mod, error } = route.entry.data;
const prefix = `${language}/`;
const slug = route.id.startsWith(prefix) ? route.id.slice(prefix.length) : route.id;
const badge = Object.entries(stability.value).find(([page]) => page === slug)?.[1];
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const area = language.equals(Languages.site.root) ? '' : `/${language}`;
const chapter = `${base}${area}/dev/stability/`;
---

{
  !front && (
    <>
      {error !== undefined && (
        <p class="ew-error-code">
          <span>{t('error.code')}</span> <code>{error.code}</code>
        </p>
      )}
      <Default />
      {badge !== undefined && (
        <p class="ew-stability">
          <a
            class:list={['ew-stability__badge', `ew-stability__badge--${badge.level}`]}
            href={chapter}
            title={Texts.site.fill(
              `stability.${badge.level}.title`,
              { count: badge.unstable.length },
              language,
            )}
          >
            {t(`stability.${badge.level}`)}
          </a>
        </p>
      )}
      {mod !== undefined && <ModCard mod={mod} language={language} />}
    </>
  )
}
