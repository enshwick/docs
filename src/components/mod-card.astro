---
import { ModCard, type ModCardData } from '../site/mod-card.ts';
import { texts } from '../site/texts.ts';
import type { LanguageCode } from '../site/types.ts';

interface Props {
  /** The mod's facts, from its page's front matter. */
  mod: ModCardData;
  /** The page's language. */
  language: LanguageCode;
}

// The head of a mod's page: what it is, who needs it, which version, and where to get it.
const { mod, language } = Astro.props;
const t = (key: string): string => texts.get(key, language);
const repository = `https://github.com/${mod.repository}`;
---

<section class="ew-mod-card" aria-label={t('mod.card')}>
  <dl>
    <div>
      <dt>{t('mod.needs')}</dt>
      <dd>{t(`mod.who.${mod.needs}`)}</dd>
    </div>
    <div>
      <dt>{t('mod.id')}</dt>
      <dd><code>{mod.id}</code></dd>
    </div>
    {
      mod.version !== undefined && (
        <div>
          <dt>{t('mod.version')}</dt>
          <dd>{mod.version}</dd>
        </div>
      )
    }
    {
      mod.api !== undefined && (
        <div>
          <dt>{t('compat.needs-api')}</dt>
          <dd>{mod.api}</dd>
        </div>
      )
    }
  </dl>
  <p class="ew-mod-card__links">
    <a class="ew-mod-card__download" href={ModCard.archive(mod)}>{t('nav.download')}</a>
    <a href={`${repository}/releases/tag/${mod.release}`}>{t('mod.release')}</a>
    <a href={ModCard.source(mod)}>{t('mod.source')}</a>
  </p>
</section>
