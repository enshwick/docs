---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

import { Area } from '../site/area.ts';
import { Languages } from '../site/languages.ts';
import { Links } from '../site/links.ts';
import { Texts } from '../site/texts.ts';
import { Translations } from '../site/translations.ts';
import LanguageSelect from './language-select.astro';
import ServiceIcon from './service-icon.astro';

// One bar on every page, the front page included: where to go, search, the outside places, download.
const route = Astro.locals.starlightRoute;
const language = Languages.site.of(route.lang);
const t = (key: string): string => Texts.site.get(key, language);
const href = (path: string): string => Translations.href(path, language);
const area = Area.of(route.id).toString();
// The coverage and aims pages each have their own item in the bar, apart from their area's, in any language.
const coverage = /^([a-z-]+\/)?dev\/api-coverage$/u.test(route.id);
const aims = /^([a-z-]+\/)?aims$/u.test(route.id);
---

<div class="ew-bar">
  <div class="ew-bar__title">
    <SiteTitle />
    <span class="ew-alpha" title={t('alpha.title')}>{t('alpha.mark')}</span>
  </div>

<script>
  import { LoadingLine } from '../scripts/loading-line.ts';

  LoadingLine.start();
</script>
  <nav class="ew-bar__nav" aria-label={t('nav.main')}>
    <a href={href('/start/first-modded-game/')} aria-current={area === 'players' && !aims ? 'true' : undefined}>
      {t('topic.players')}
    </a>
    <a href={href('/dev/')} aria-current={area === 'dev' && !coverage ? 'true' : undefined}>{t('topic.developers')}</a>
    <a href={href('/dev/api-coverage/')} aria-current={coverage ? 'true' : undefined}>{t('nav.coverage')}</a>
    <a href={href('/aims/')} aria-current={aims ? 'true' : undefined}>{t('nav.aims')}</a>
  </nav>
  <div class="ew-bar__search">
    <Search />
  </div>
  <div class="ew-bar__out">
    <a class="ew-bar__service" href={Links.site.github.toString()} aria-label="GitHub" title="GitHub">
      <ServiceIcon service="github" />
    </a>
    <a class="ew-bar__service" href={Links.site.nexus.toString()} aria-label="Nexus Mods" title="Nexus Mods">
      <ServiceIcon service="nexus" />
    </a>
    <LanguageSelect language={language} />
    <a class="ew-bar__download" href={Links.site.download.toString()}>{t('nav.download')}</a>
  </div>
</div>
