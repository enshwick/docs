---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';

import { Area } from '../site/area.ts';
import { languages } from '../site/languages.ts';
import { links } from '../site/links.ts';
import { texts } from '../site/texts.ts';
import { LanguageCode } from '../site/types.ts';
import ServiceIcon from './service-icon.astro';

// One bar on every page, the front page included: where to go, search, the outside places, download.
const route = Astro.locals.starlightRoute;
const parsed = LanguageCode.parse(route.lang);
const language = parsed.ok ? parsed.value : languages.root;
const t = (key: string): string => texts.get(key, language);
const base = import.meta.env.BASE_URL.replace(/\/$/u, '');
const prefix = language.equals(languages.root) ? base : `${base}/${language}`;
const area = Area.of(route.id).toString();
---

<div class="ew-bar">
  <div class="ew-bar__title">
    <SiteTitle />
    <span class="ew-alpha" title={t('alpha.title')}>{t('alpha.mark')}</span>
  </div>

<script>
  import { LoadingLine } from '../scripts/loading-line.ts';

  LoadingLine.start();
</script>
  <nav class="ew-bar__nav" aria-label={t('nav.main')}>
    <a href={`${prefix}/start/first-modded-game/`} aria-current={area === 'players' ? 'true' : undefined}>
      {t('topic.players')}
    </a>
    <a href={`${prefix}/dev/`} aria-current={area === 'dev' ? 'true' : undefined}>{t('topic.developers')}</a>
  </nav>
  <div class="ew-bar__search">
    <Search />
  </div>
  <div class="ew-bar__out">
    <a class="ew-bar__service" href={links.github.toString()} aria-label="GitHub" title="GitHub">
      <ServiceIcon service="github" />
    </a>
    <a class="ew-bar__service" href={links.nexus.toString()} aria-label="Nexus Mods" title="Nexus Mods">
      <ServiceIcon service="nexus" />
    </a>
    <a class="ew-bar__service" href={links.vortex.toString()} aria-label={t('foot.vortex')} title={t('foot.vortex')}>
      <ServiceIcon service="vortex" />
    </a>
    <LanguageSelect />
    <a class="ew-bar__download" href={links.download.toString()}>{t('nav.download')}</a>
  </div>
</div>
