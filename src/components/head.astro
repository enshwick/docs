---
import Default from '@astrojs/starlight/components/Head.astro';
import { ClientRouter } from 'astro:transitions';

import compat from '../generated/compatibility.json';
import modLines from '../data/mods.json';
import { Area } from '../site/area.ts';
import { Coverage } from '../site/coverage.ts';
import { FirstFonts } from '../site/first-fonts.ts';
import { FrontData } from '../site/front.ts';
import { Languages } from '../site/languages.ts';
import { ModLanguageKeys } from '../site/mod-language-keys.ts';
import { ModLanguages } from '../site/mod-languages.ts';
import { type SidebarItem, StructuredData } from '../site/structured-data.ts';
import { Texts } from '../site/texts.ts';
import { LanguageCode } from '../site/types.ts';
import { WebAnalytics } from '../site/web-analytics.ts';

const route = Astro.locals.starlightRoute;
const id = route.id;
const area = Area.of(id);
// A mod's own page, in any language, gets its facts drawn as the game's item card.
const mod = /^([a-z-]+\/)?mods\/[a-z0-9-]+$/u.test(id);
const lang = route.lang;
const parsedLanguage = LanguageCode.parse(lang);
const language = parsedLanguage.ok ? parsedLanguage.value : Languages.site.root;
const home = ['/', ...Languages.site.others.map((code) => `/${code}/`)].includes(Astro.url.pathname);
const data = Astro.site === undefined ? undefined : new StructuredData(Astro.site.href);
const page = {
  path: Astro.url.pathname,
  title: route.entry.data.title,
  description: route.entry.data.description,
  lang,
  lastUpdated: route.lastUpdated,
};
// A fallback page copies another and stays out of search; the 404 page is no document.
const nodes =
  data === undefined || route.isFallback === true || id === '404'
    ? []
    : home
      ? data.home(lang, FrontData.from(compat, modLines, lang).version, {
          description: route.entry.data.description ?? Texts.site.get('site.description', language),
          questions: FrontData.questions.map((question) => ({
            question: Texts.site.get(`front.faq.${question}.q`, language),
            answer: Texts.site.get(`front.faq.${question}.a`, language),
          })),
        })
      : [
          // Starlight's sidebar entries carry more fields than the breadcrumbs read.
          ...data.article(page, route.sidebar as SidebarItem[], route.siteTitle),
          ...(Astro.url.pathname.endsWith(Coverage.page)
            ? [data.dataset(page, Coverage.site.latest(route.lastUpdated).toISOString(), Coverage.data)]
            : []),
        ];
// The two faces every first screen sets, in the scripts the page's language needs, fetched early.
const fonts = new FirstFonts(Languages.site.root.toString() !== lang).urls;
// Each page's own social card, drawn at build time by the route under `src/pages/og/`, which
// names the root home page `index` where Starlight's route gives it an empty id.
const ogId = route.entry.id === '' ? 'index' : route.entry.id;
const beacon = WebAnalytics.site.beacon;
const ogImage =
  Astro.site === undefined || id === '404'
    ? undefined
    : new URL(`${import.meta.env.BASE_URL.replace(/\/$/u, '')}/og/${ogId}.png`, Astro.site).href;
---

<Default />
{fonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<ClientRouter />
{beacon !== undefined && <script is:inline defer src={WebAnalytics.script} data-cf-beacon={beacon}></script>}
<meta name="ew-area" content={area.toString()} />
{mod && <meta name="ew-mod" />}
{ogImage !== undefined && <meta property="og:image" content={ogImage} />}
{nodes.length > 0 && <script is:inline type="application/ld+json" set:html={StructuredData.script(nodes)} />}
<script is:inline define:vars={{ area: area.toString(), mod }}>
  document.documentElement.dataset.area = area;
  if (mod) document.documentElement.dataset.mod = '';
</script>
<style is:inline set:html={ModLanguages.site.css}></style>
<script is:inline define:vars={{ key: ModLanguageKeys.storageKey, fallback: ModLanguages.site.fallback }}>
  // Before the body paints, so a block for another language never shows for a moment.
  let chosen = null;

  try {
    chosen = localStorage.getItem(key);
  } catch {}

  document.documentElement.dataset.modLanguage = chosen ?? fallback;
</script>
<script>
  import { ModLanguage } from '../scripts/mod-language.ts';
  import { PageSwap } from '../scripts/page-swap.ts';

  PageSwap.start();
  ModLanguage.start();
</script>
