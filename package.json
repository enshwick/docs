{
  "name": "enshwick-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "fetch": "bun tools/fetch.ts",
    "check:player-page": "bun tools/check-player-page.ts",
    "dev": "bun tools/fetch.ts && bun --bun astro dev",
    "build": "bun tools/fetch.ts && bun --bun astro build",
    "check": "bun --bun astro check && oxlint --type-aware && bun --bun vitest run && bun tools/check-dist.ts",
    "preview": "bun --bun astro preview",
    "check:dist": "bun tools/check-dist.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.6",
    "@expressive-code/plugin-collapsible-sections": "0.44.3",
    "@expressive-code/plugin-line-numbers": "0.44.3",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@horizon-republic/nominal-types": "3.1.0",
    "astro": "7.3.8",
    "astro-og-canvas": "0.13.2",
    "sharp": "0.35.5",
    "starlight-github-alerts": "0.5.0",
    "starlight-heading-badges": "0.8.0",
    "starlight-image-zoom": "0.16.1",
    "starlight-kbd": "0.4.0",
    "starlight-links-validator": "0.27.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-sidebar-topics": "0.9.0",
    "starlight-sidebar-topics-dropdown": "0.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/bun": "1.4.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
