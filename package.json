{
  "name": "enshwick-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "fetch": "bun tools/fetch.ts",
    "check:player-page": "bun tools/check-player-page.ts",
    "dev": "bun tools/fetch.ts && bun --bun astro dev",
    "build": "bun tools/fetch.ts && bun --bun astro build",
    "check": "bun tools/check-types.ts && oxfmt --check && oxlint && bun --bun vitest run && bun tools/check-dist.ts && bun tools/check-prose.ts",
    "preview": "bun --bun astro preview",
    "check:dist": "bun tools/check-dist.ts",
    "check:prose": "bun tools/check-prose.ts",
    "check:types": "bun tools/check-types.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.8",
    "@expressive-code/plugin-collapsible-sections": "0.44.3",
    "@expressive-code/plugin-line-numbers": "0.44.3",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@horizon-republic/nominal-types": "3.1.0",
    "astro": "7.4.5",
    "astro-og-canvas": "0.13.3",
    "sharp": "0.35.5",
    "starlight-github-alerts": "0.5.0",
    "starlight-heading-badges": "0.8.0",
    "starlight-image-zoom": "0.16.2",
    "starlight-kbd": "0.4.0",
    "starlight-links-validator": "0.27.0",
    "starlight-llms-txt": "0.12.0",
    "starlight-sidebar-topics": "0.9.0",
    "starlight-sidebar-topics-dropdown": "0.7.1"
  },
  "devDependencies": {
    "@astrojs/ts-content-mapper": "0.2.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.4.4",
    "eslint-plugin-jsdoc": "65.4.2",
    "lefthook": "2.2.2",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.1.0-beta",
    "vitest": "5.1.0",
    "wrangler": "4.157.0"
  }
}
